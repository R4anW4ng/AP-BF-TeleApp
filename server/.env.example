# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ap_building_fund?schema=public"
# Used only by the Prisma CLI (migrate deploy, db seed). Leave empty locally.
# On Supabase: DATABASE_URL = Transaction pooler (port 6543, ?pgbouncer=true) for the app,
#              DIRECT_URL   = Session pooler (port 5432, IPv4) for migrations.
DIRECT_URL=""

# --- Telegram ----------------------------------------------------------------
# From @BotFather. Also the HMAC key for initData validation — keep it secret.
TELEGRAM_BOT_TOKEN="123456789:replace-with-your-bot-token"
# Where the Mini App is hosted (must be HTTPS for Telegram). The first URL is what
# the bot's "Open app" button launches; all of them are allowed by CORS.
WEBAPP_URL="https://your-miniapp.example.org"
# Long-poll Telegram in this process. Only ONE running instance may poll per token.
BOT_POLLING=true
# Run the Monday 05:00 SGT broadcast in this process (one instance is enough;
# a second can't double-send, but there's no need for it).
CRON_ENABLED=true
# Reject initData older than this (seconds). 86400 = 24h.
INIT_DATA_MAX_AGE_SECONDS=86400
# Comma-separated Telegram user IDs that are always admins.
ADMIN_TELEGRAM_IDS="123456789"
# Reverse proxies in front of the app (Render/Railway/Fly/nginx: usually 1).
TRUST_PROXY=0

# --- Campaign ----------------------------------------------------------------
ZONE_NAME="AP"
CAMPAIGN_START="2026-10-19"
CAMPAIGN_END="2027-02-28"

# --- Photo storage: Cloudflare R2 (any S3-compatible service works) -----------
# R2 dashboard → R2 → Manage API tokens → "Object Read & Write" for this bucket.
# ⚠️ This file is committed to a PUBLIC repo. Put the real key ID and secret in
# server/.env (git-ignored), never here.
S3_ENDPOINT="https://995e792a7dd9941d999c8e06da5b97bd.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="ap-bf-uploads"
# Public bucket URL (custom domain or https://pub-xxxx.r2.dev). Leave empty to
# keep the bucket private and serve 1-hour presigned URLs instead.
MEDIA_PUBLIC_BASE_URL=""

# --- Seeding -----------------------------------------------------------------
SEED_CELL_GROUPS="AP1,AP2,AP3,AP4"
# Set to true for a sample Home challenge in local dev (never in production).
SEED_SAMPLE_CONTENT=false
