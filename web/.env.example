# Base URL of the API. Leave empty when the API is served from the same origin
# (in `npm run dev` the Vite proxy forwards /api to localhost:3000).
VITE_API_URL=

# DEVELOPMENT ONLY: lets you open the app in a normal browser, outside Telegram.
# Generate with:  npm run -s sign-init-data -w server -- <yourTelegramId> <Name>
# and paste the value WITHOUT the leading "tma ". Ignored in production builds.
VITE_DEV_INIT_DATA=
